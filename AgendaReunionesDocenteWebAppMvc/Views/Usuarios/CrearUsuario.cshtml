@model AgendaReunionesDocenteWebAppMvc.Models.DTOS.UsuarioDTO
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Crear Usuario</title>
    <style>
        .contenedor {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .card-header {
            background-color: teal !important;
        }
    </style>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")

    <div class="contenedor">
        <div class="col-6">
            <div class="card">
                @{ 
                    string mensaje = TempData["mensaje"] as string;
                    if (!string.IsNullOrWhiteSpace(mensaje))
                    {
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <span class="fa fa-times-circle me-3"></span>
                            <div>
                                @mensaje
                            </div>
                        </div>
                    }
                }
                <div class="card-header text-center">
                    <h5 style="color:#fefefe">REGISTRAR USUARIO</h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="row">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="form-group col-md-6 mb-2">
                                @Html.LabelFor(model => model.Nombres, htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-12">
                                    @Html.EditorFor(model => model.Nombres, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Nombres, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group col-md-6 mb-2">
                                @Html.LabelFor(model => model.Apellidos, htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-12">
                                    @Html.EditorFor(model => model.Apellidos, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Apellidos, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group col-md-6 mb-2">
                                @Html.LabelFor(model => model.Edad, htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-12">
                                    @Html.EditorFor(model => model.Edad, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Edad, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group col-md-6 mb-2">
                                @Html.LabelFor(model => model.Genero, htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-12">
                                    @Html.DropDownListFor(model => model.Genero, (IEnumerable<SelectListItem>)ViewBag.Generos, "Seleccione un género", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Genero, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group col-md-6 mb-2">
                                @Html.LabelFor(model => model.Correo, htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-12">
                                    @Html.EditorFor(model => model.Correo, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Correo, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group col-md-6 mb-2">
                                @Html.LabelFor(model => model.Telefono, htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-12">
                                    @Html.EditorFor(model => model.Telefono, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Telefono, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group col-md-6 mb-2">
                                @Html.LabelFor(model => model.Usuario, htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-12">
                                    @Html.EditorFor(model => model.Usuario, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Usuario, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group col-md-6 mb-2">
                                @Html.LabelFor(model => model.Password1, htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-12">
                                    @Html.EditorFor(model => model.Password1, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Password1, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group col-md-6 mb-2 offset-6">
                                @Html.LabelFor(model => model.Password2, htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-12">
                                    @Html.EditorFor(model => model.Password2, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Password2, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="mt-3 d-flex justify-content-between">
                                <button type="submit" class="btn btn-success">
                                    <i class="fa fa-floppy-o"></i>
                                    <span>Guardar</span>
                                </button>
                                <a href="@Url.Action("Login")" class="btn btn-secondary">
                                    <i class="fa fa-arrow-left"></i> Volver
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div>
        @Html.ActionLink("Back to List", "Index")
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/sweetalert")
</body>
</html>
