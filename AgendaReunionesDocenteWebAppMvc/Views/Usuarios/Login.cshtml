
@model AgendaReunionesDocenteWebAppMvc.Models.LoginDTO
@{
    Layout = null;
}
@Styles.Render("~/Content/css")
@Scripts.Render("~/bundles/modernizr")

<style>
    .contenedor {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .login-form {
        width: 400px;
        max-width: 600px;
        min-width: 300px;
    }
</style>

<div class="contenedor">
    @using (Html.BeginForm("Login", "Usuarios", FormMethod.Post, new { @class= "login-form" }))
    {
        <div class="card">
            <div class="card-header text-center">
                <h5>LOGIN</h5>
            </div>
            <div class="card-body">

                <div class="mb-3">
                    @Html.LabelFor(m => m.Usuario)
                    @Html.TextBoxFor(m => m.Usuario, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "text-danger" })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.Clave)
                    @Html.PasswordFor(m => m.Clave, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Clave, "", new { @class = "text-danger" })
                </div>
                <div class="mb-3 d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">
                        <span>Iniciar sesión</span>
                        <i class="fa fa-sign-in"></i>
                    </button>
                    <span>No posee cuenta, <a href="~/Usuarios/CrearUsuario">Registrarse</a></span>
                </div>
            </div>
        </div>
    }
</div>

@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")
@Scripts.Render("~/bundles/sweetalert")